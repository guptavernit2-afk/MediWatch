# Fictional data and background simulator. Keep true for public demonstrations.
DEMO_MODE=true

# SQLite database location. Use an absolute path on a persistent hosted volume.
# Relative paths resolve from the application working directory.
# Backup, restore, and later persistent-disk setup: docs/STORAGE.md
MEDIWATCH_DB_PATH=data/mediwatch.db

# Required when DEMO_MODE=false. Generate a long random value and keep it private.
# Never paste an actual token into this example file.
MEDIWATCH_API_TOKEN=

# Optional: summaries work through local rules when no key is configured.
# Provider summaries are generated only after an explicit request.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
